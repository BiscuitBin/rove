{
  "config": {
    "default": true,
    // Prose is wrapped by the author, not by a column limit.
    "MD013": false,
    // Duplicate headings are legitimate under different parents.
    "MD024": { "siblings_only": true },
    // Frontmatter carries a title field, but the level-one heading in the body
    // is the document's real title and the contract requires it.
    "MD025": { "front_matter_title": "" },
    // AGENTS.md uses <important if> blocks.
    "MD033": { "allowed_elements": ["br", "important"] },
    // The documentation contract owns the first heading, not markdownlint.
    "MD041": false
  },
  // No "globs": markdownlint-cli2 would append them to the files prek passes,
  // and lint (and, under `just fix`, rewrite) every .md on disk, untracked and
  // ignored ones included. Only the files prek passes are linted.
  "ignores": ["target", ".venv", "ai_tmp", "allium-skill-reference"]
}
