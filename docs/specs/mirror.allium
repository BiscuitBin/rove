-- allium: 3
--
-- mirror — the mirror on disk and the pages, links and indexes in it
--
-- Scope
--   What a mirror is: an output directory holding page files, a manifest
--   of pages, aliases and links, generated indexes and the last report,
--   laid out in fixed namespaces: collected pages under pages/<host>/,
--   their archived copies under _removed/<host>/, the per-directory
--   indexes under _indexes/<host>/, and every managed file at the root.
--   This module says how a page is identified, where its file lives, what
--   happens when its URL moves or the page disappears, how links between
--   pages are rewritten, how the indexes are generated, and what verify
--   checks. The crawl hands it page candidates; the root hands it passes
--   (finalise, index, verify) and reads what it emits.
--
-- Includes
--   The crawl scope and URL identity; the page lifecycle (written and
--   removed, moves, revival, duplicates); aliases; the removed area and
--   pruning; path assignment; the ownership declaration; link resolution,
--   rewriting and the link flags; frontmatter; the indexes (index.md,
--   index.jsonl, links.jsonl, llms.txt and the directory indexes under
--   _indexes/); keywords; the finalisation of a run; verification.
--
-- Excludes
--   Fetching, discovery, the frontier, politeness, tiers and owner testing
--   (crawl); conversion and the quality gates (convert); commands, exit
--   codes and the crawl report (rovo); storage mechanics (the manifest's
--   format, atomic writes).
--
-- Dependencies
--   convert.allium: Profile, ConvertedContent, QualityResult, QualityFlag,
--   ExtractionMethod and config.incomplete_flags.
--
-- Vocabulary
--   mirror: the output directory, its page files, manifest, indexes and
--   last report. page, page file: a mirrored page and its .md file.
--   identity: the normalised URL that keys a page; canonical URL is what a
--   page declares about itself; source URL is the URL whose response was
--   converted, after redirects. alias: any other URL that resolves to a
--   page (a redirect hop, a non-canonical URL). removed, removed area: a
--   page gone at the source; _removed/, a root sibling of pages/ that
--   mirrors it, holds its archived file unless prune deletes it. moved: a page whose identity changed, so its path
--   changed. absent: a URL that answers 404 or 410. uncrawled: a link to
--   an in-scope URL with no page; the page flag is uncrawled_internal.
--   dangling: a link to a removed page; the page flag is dangling_inbound.
--   pass: one finalise, index or verify job over the mirror. tier: the
--   fetch tier a page's response came from (http, browser, stealth).
--   layout: the mirror's root holds the managed files (rovo.toml,
--   crawl-report.json, index.md, index.jsonl, links.jsonl, llms.txt,
--   .rovo/) and three namespaces beside them: pages/ (collected pages
--   only, one directory per host), _removed/ and _indexes/. Any other
--   file at the root, such as .git/, is the operator's and is left alone.
--   host segment: the directory under pages/ that holds one host's pages,
--   named from the identity's host as the guidance of MovePage states
--   (the bracketed IPv6 form as written: [::1]:8080 gives ---1-_8080).
--   device name: CON, PRN, AUX, NUL, COM1 to COM9 or LPT1 to LPT9,
--   matched ignoring case on the part of a segment before its first ".".
--   docs/project/terminology.md is the glossary.
--
-- Black box functions (pure): normalise_url, hostname_of, scheme_of,
-- path_of, first_path_segment, resolve_url, pattern_matches, starts_with,
-- known_page, assign_path, version_label, link_destinations,
-- rewrite_destinations, digest, keywords_of, frontmatter_of,
-- page_file_current, index_entries, link_index_entries,
-- directory_indexes_for, llms_summary, find_broken_links,
-- verification_failures, gate_flag, casefold, ends_with, page_root,
-- segments_below, directory_segments_below, stem_before_first_dot. Their
-- contracts are stated
-- where they are used.
use "./convert.allium" as convert

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The person or script running a command. What an invocation carries
-- (confirmation, interactivity, progress format) travels with the command
-- in the root module; the operator itself has no state here.
external entity Operator {
}

-- A sync run, as the mirror sees it: the party that delivers page
-- candidates. A type placeholder that crawl.allium's Run stands in for;
-- that module governs its lifecycle.
external entity SyncRun {
    id: Integer                         -- mirror-local, stable, never reused
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- The one URL scope of a mirror. It serves the crawl, path assignment and
-- link classification alike: a link is uncrawled when its target is within
-- the crawl's bounds, whether or not depth or robots let the crawl fetch
-- it. The root builds it from the resolved
-- configuration and the profile at run start; start URLs are always in
-- scope and define the default hosts and prefixes. It carries the root and
-- start URLs so that the crawl seeds discovery from the scope it was given.
value CrawlScope {
    root_url: String?                   -- the configured root URL, when one is set
    start_urls: List<String>            -- the configured start URLs
    allowed_hosts: Set<String>          -- host names, lower-cased, port dropped
    path_prefixes: List<String>
    include: List<String>               -- glob, or regex when prefixed re:
    exclude: List<String>
    max_depth: Integer
    locale: String?                     -- pinned locale; null = no pinning
    meaningful_query_params: List<String>
    locale_codes: Set<String>           -- from the profile: the segments that are locales

    -- Identity: lower-case scheme and host, a host's trailing "." dropped
    -- (example.com. and example.com are one identity), default port
    -- dropped, dot segments resolved, a trailing index.html folded into "/", only
    -- meaningful (never tracking) query parameters kept and sorted, the
    -- fragment dropped, a trailing slash kept. A URL normalise_url cannot
    -- normalise (a port out of range, say) has no identity: null.
    identity_of(url): normalise_url(url, meaningful_query_params)

    host_allowed(url): hostname_of(identity_of(url)) in allowed_hosts

    -- Only the first path segment is ever a locale, and only when the
    -- profile lists it as one.
    foreign_locale(url):
        locale != null
        and first_path_segment(identity_of(url)) in locale_codes
        and first_path_segment(identity_of(url)) != locale

    -- The URLs discovery starts from: the start URLs, else the root URL.
    seeds: if start_urls.count > 0: start_urls else if root_url != null: [root_url] else: []

    is_seed(url): seeds.any(s => identity_of(s) = identity_of(url))

    -- In bounds without regard to depth: the test path assignment and link
    -- classification use. Patterns match the identity, not the raw URL; a
    -- malformed URL is out of bounds. A seed is always in bounds.
    within_bounds(url):
        is_seed(url)
        or (scheme_of(identity_of(url)) in {"http", "https"}
            and host_allowed(url)
            and path_prefixes.any(p => starts_with(path_of(identity_of(url)), p))
            and not exclude.any(p => pattern_matches(identity_of(url), p))
            and (include.count = 0 or include.any(p => pattern_matches(identity_of(url), p)))
            and not foreign_locale(url))

    allows(url, depth): within_bounds(url) and depth >= 0 and depth <= max_depth

    -- Default stated here (veto at review): a declared canonical becomes
    -- the identity whenever its host is allowed, even outside the path
    -- prefixes; otherwise the source URL's identity stands.
    page_identity(source_url, canonical_url):
        if canonical_url != null and host_allowed(canonical_url): identity_of(canonical_url)
        else: identity_of(source_url)
}

-- The YAML block at the top of every page file. Keys are sorted and absent
-- values are omitted. It carries no wall-clock time and none of the site's
-- validators: fetch times, etag and last_modified live in the manifest,
-- so an unchanged page's file never changes. Decided: sitemap_lastmod
-- stays in it, so a sitemap lastmod that moves rewrites the page file.
value Frontmatter {
    source_url: String
    title: String
    content_digest: String              -- of the body only, never the frontmatter
    quality_score: Decimal
    low_confidence: Boolean
    quality_flags: Set<convert/QualityFlag>
    tier: Tier
    method: convert/ExtractionMethod
    profile: String
    keywords: List<String>
    description: String?
    canonical_url: String?
    breadcrumbs: List<String>?
    sitemap_lastmod: String?
    version: String?
    locale: String?
}

-- One line of index.jsonl, and the source of index.md and llms.txt lines.
-- Every path an index records is mirror-relative, so a page's path starts
-- with pages/<host>/. Every field comes from the manifest's page and its
-- links, never from the page file; BuildIndexes states the line encoding.
-- The site's validators (etag, last_modified) are not among its fields.
value IndexEntry {
    path: String                        -- the page's mirror-relative path, under pages/<host>/
    identity: String
    source_url: String
    title: String
    description: String
    keywords: List<String>
    headings: List<String>
    quality_score: Decimal
    low_confidence: Boolean
    quality_flags: Set<convert/QualityFlag>
    content_digest: String
    version: String?
    locale: String?
    word_count: Integer                 -- words the quality measurement counted outside code (quality.output.words)
    outbound_internal: Integer
    inbound_internal: Integer
}

-- One line of links.jsonl: a URL some page links to, whether or not the
-- mirror holds a page for it.
value LinkIndexEntry {
    url: String                         -- the identity, without fragment
    kind: LinkKind
    path: String?                       -- when a written page holds the URL; mirror-relative, under pages/<host>/
    cited_by: List<String>              -- sorted mirror-relative paths of the pages that link to it
}

-- A generated per-directory index. A directory below a host's top level,
-- pages/<host>/<dir>, is indexed at _indexes/<host>/<dir>.md, its path
-- lower-cased: pages/docs.example/api gives _indexes/docs.example/api.md
-- (was api/_index.md) and pages/docs.example/api/v2 gives
-- _indexes/docs.example/api/v2.md. Directories that differ only in case
-- form one group and share one index, named in lower case. A host's top
-- level never gets a directory index: index.md lists its pages. The file's
-- text is "# <heading>", then its nearest indexed descendants, then its
-- entries, as BuildIndexes states.
value DirectoryIndex {
    directory: String                   -- the full directory path, lower-cased, e.g. pages/docs.example/api
    path: String                        -- the index file, _indexes/<host>/<dir>.md
    heading: String                     -- <host>/<dir>: directory without its pages/ prefix, e.g. docs.example/api
    entries: List<IndexEntry>           -- the pages directly in the directory, in path order
}

-- A relative link in a page file that reaches no file or no anchor, or a
-- page file that is missing (href "", reason missing_file).
value BrokenLink {
    from_path: String
    href: String
    reason: BrokenLinkReason
}

-- One finding of verify.
value VerificationFailure {
    path: String
    reason: VerificationReason
    detail: String                      -- the gate, link or digest concerned
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- The fetch tiers, declared here because a page records the tier its
-- response came from; the crawl walks them.
enum Tier { http | browser | stealth }

-- internal: a written page holds the target. uncrawled: in bounds, no
-- page. dangling: the target is a removed page. external: anything else.
enum LinkKind { internal | uncrawled | dangling | external }

enum BrokenLinkReason { missing_file | outside_mirror | fragment_not_found }

enum VerificationReason {
    missing_file | unmanaged_file | invalid_page_file | digest_mismatch
    | quality_drift | broken_link | index_stale
}

-- Why a page was removed: it answered 404 or 410, or no longer answers
-- HTML (absent), it redirected out of scope, it fell outside a narrowed
-- scope, or its URL now resolves to another page (merged).
enum RemovalReason { absent | redirected_out | out_of_scope | merged }

-- What one settled fetch delivers.
enum CandidateOutcome { converted | unchanged | absent | redirected_out }

-- What finalisation found a page to be, relative to the last run.
enum StoreOutcome { added | changed | unchanged | moved }

enum PassKind { finalise | index | verify }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- An output directory and its manifest. The root creates it at init and
-- writes its scope at every run start; the crawl and the passes read it.
entity Mirror {
    out_dir: String
    scope: CrawlScope
    profile: convert/Profile
    declared_owned_hosts: Set<String>   -- the operator's saved "I own this host" statement, unverified
    recorded_root_url: String?          -- the root URL the last run used
    processing_signature: String        -- digest of the conversion settings and the profile; never budgets or seeds

    pages: Page with mirror = this
    aliases: Alias with mirror = this
    index: Index with mirror = this

    written_pages: pages where status = written
    removed_pages: pages where status = removed
    page_paths: written_pages -> path
    is_populated: written_pages.count > 0
    has_declared_owner: declared_owned_hosts.count > 0
}

-- A page of the mirror: written, or removed at the source. A removed page
-- keeps its record and its path so that a return restores it in place.
entity Page {
    mirror: Mirror
    identity: String
    path: String                        -- mirror-relative .md path under pages/<host>/; changes when the identity moves, at a revival and back at its retirement
    canonical_url: String?              -- what the page declared, when it did
    source_url: String                  -- the URL whose response was converted
    title: String
    description: String
    method: convert/ExtractionMethod
    tier: Tier
    quality: convert/QualityResult      -- the measurement at conversion, fetch flags included
    flags: Set<convert/QualityFlag>     -- quality.flags plus the link flags of the last finalisation
    low_confidence: Boolean             -- recomputed after link rewriting with convert's definition
    anchors: Set<String>
    headings: List<String>
    keywords: List<String>              -- a pure function of the body
    breadcrumbs: List<String>
    locale: String?
    version: String?
    raw_digest: String                  -- of the fetched HTML; the crawl's change shortcut
    content_digest: String              -- of the published body; serves change detection and the frontmatter
    previous_digest: String?            -- content_digest before this run touched the page; null when new or revived
    moved_from: String?                 -- the old path while a move awaits finalisation
    revived_from: String?               -- a revived page's removed path, where its archived copy is, until finalisation
    etag: String?
    last_modified: String?
    sitemap_lastmod: String?
    processing_signature: String        -- the mirror's signature when the page was converted
    converted_body: String              -- Markdown with absolute links, as converted
    body: String                        -- Markdown with rewritten links, as published
    frontmatter: Frontmatter?           -- set at finalisation
    last_outcome: StoreOutcome          -- what the last finalisation found the page to be
    last_seen_run: Integer              -- the run that last fetched or confirmed the page
    last_stored_run: Integer            -- the run that last stored converted content
    first_seen: Timestamp
    fetched_at: Timestamp               -- moves when converted content was stored
    last_seen: Timestamp
    last_changed: Timestamp             -- moves when the published body changed
    status: written | removed
    removed_at: Timestamp when status = removed
    removal_reason: RemovalReason when status = removed
    redirect_target: String?            -- recorded when the page redirected out of scope

    outbound_links: Link with source = this
    inbound_links: Link with target = this
    aliases: Alias with target = this

    internal_outbound: outbound_links where kind = internal
    internal_inbound: inbound_links where kind = internal
    outbound_internal: internal_outbound.count
    inbound_internal: internal_inbound.count
    has_uncrawled_link: outbound_links.any(l => l.kind = uncrawled)
    has_dangling_link: outbound_links.any(l => l.kind = dangling)
    has_unresolved_fragment: outbound_links.any(l => not l.fragment_resolved)
    is_new_this_run: previous_digest = null
    was_moved: moved_from != null

    invariant ScoreIsAFraction {
        quality.score >= 0 and quality.score <= 1
    }

    invariant FullScoreIffAllGatesPass {
        quality.all_gates_pass = (quality.score = 1)
    }

    invariant FailedGatesAreFlagged {
        quality.failed.all(g => gate_flag(g) in flags)
    }

    invariant LowConfidenceDefinition {
        low_confidence = (not quality.all_gates_pass or flags.any(f => f in convert/config.incomplete_flags))
    }

    invariant LinkFlagsAgreeWithLinks {
        status = written implies
            (uncrawled_internal in flags) = has_uncrawled_link
            and (dangling_inbound in flags) = has_dangling_link
            and (unresolved_fragment in flags) = has_unresolved_fragment
    }

    invariant KeywordsAreBounded {
        keywords.count <= config.keywords_per_page
            and keywords.unique.count = keywords.count
    }

    transitions status {
        written -> removed
        removed -> written
    }
}

-- A URL that resolves to a page: a redirect hop or a non-canonical URL.
-- An alias points at the page itself, so it follows an identity move and
-- is dropped with the page.
entity Alias {
    mirror: Mirror
    url: String
    target: Page

    invariant AliasIsNotItsTarget {
        url != target.identity
    }
}

-- One outbound link of a page, as resolved at the last finalisation. The
-- whole set of a page is replaced each time; images never become links.
entity Link {
    source: Page
    target_identity: String             -- the destination's identity, before alias resolution
    fragment: String?
    kind: LinkKind
    target: Page?                       -- present when kind = internal
    fragment_resolved: Boolean          -- no fragment, or the fragment names an anchor of the target

    invariant OnlyInternalLinksHaveTargets {
        (kind = internal) = (target != null)
    }
}

-- What one settled fetch delivers to the mirror: converted content, a
-- confirmation that the page is unchanged, news that it is absent, or news
-- that it redirected out of scope. The crawl creates it; the rules below
-- pick it up by `.created`, so every candidate is accepted or marked a
-- duplicate in the same step.
entity PageCandidate {
    mirror: Mirror
    run_id: Integer
    requested_identity: String          -- the frontier identity the fetch started from
    source_url: String                  -- the URL whose response was converted, after redirects
    redirect_hops: List<String>         -- every URL left behind by a redirect on the way
    redirect_target: String?            -- the out-of-scope target, when the outcome says so
    depth: Integer
    outcome: CandidateOutcome
    content: convert/ConvertedContent?  -- present for a converted outcome; fetch flags already added
    tier: Tier
    etag: String?
    last_modified: String?
    sitemap_lastmod: String?
    raw_digest: String
    status: pending | accepted | duplicate

    transitions status {
        pending -> accepted
        pending -> duplicate
        terminal: accepted, duplicate
    }
}

-- One job over the mirror, created by the root: finalise (after a run:
-- retire out-of-scope pages, resolve and rewrite links, write page files
-- and indexes), index (write the indexes offline) or verify (check the
-- mirror on disk and report).
entity MirrorPass {
    mirror: Mirror
    operator: Operator                  -- whoever the pass answers to
    kind: PassKind
    run_id: Integer?                    -- the run a finalise pass follows; null for a command
    failures: List<VerificationFailure>
    broken_links: List<BrokenLink>
    status: pending | completed

    transitions status {
        pending -> completed
        terminal: completed
    }
}

-- The generated indexes: index.md for people, index.jsonl for machines,
-- llms.txt for agents, a file under _indexes/<host>/ per large directory,
-- links.jsonl for every URL the pages cite. Regenerated from scratch by every pass that writes
-- them.
entity Index {
    mirror: Mirror
    entries: List<IndexEntry>           -- one per written page, sorted by path
    link_entries: List<LinkIndexEntry>  -- sorted by URL
    directory_indexes: List<DirectoryIndex>
    summary: String                     -- the llms.txt blockquote, as llms_summary gives it (BuildIndexes)
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

-- The page path template is fixed at "pages/{host}/{path}" and is not a
-- parameter: no configuration layer sets it, so {version} and {locale}
-- never shape a page path (the version label still does, through
-- assign_path, outside the template, and both still reach the frontmatter
-- and index.jsonl). max_path_chars is the mirror's own parameter, held
-- within its range by MaxPathCharsInRange; it is not a rovo.toml key.
-- prune is a rovo.toml key, [mirror] prune: the resolved configuration's
-- prune (rovo.allium Configuration), false by default.
config {
    max_path_chars: Integer = 200                  -- the whole mirror-relative path, pages/<host>/ included; within [128, 240]
    collision_hash_chars: Integer = 6
    keywords_per_page: Integer = 8
    keywords_min: Integer = 5
    hierarchical_index_threshold: Integer = 200    -- pages in a directory before it gets its own file under _indexes/
    llms_txt_cap: Integer = 2000                   -- past it (written pages > cap), llms.txt lists an indexed directory as one line
    prune: Boolean = false                         -- delete a removed page's file instead of archiving it
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Several rules share the PageCandidate.created trigger on purpose; their
-- guards partition the outcomes and the page states, so exactly one fires
-- per candidate. known_page(mirror, url) is the written page whose
-- identity is the URL, else the written target of an alias for the URL,
-- else null: a page's own identity beats an alias.

------------------------------------------------------------
-- Intake
------------------------------------------------------------

-- The crawl delivers one candidate per settled fetch through the
-- PageIntake surface; the root requests passes through MirrorContents.
-- Both become entities here so that the rules below pick them up.

rule AdmitCandidate {
    when: CandidateDelivered(run, mirror, requested_identity, source_url, redirect_hops, redirect_target?, depth, outcome, content?, tier, etag?, last_modified?, sitemap_lastmod?, raw_digest)
    ensures: PageCandidate.created(
        mirror: mirror, run_id: run.id, requested_identity: requested_identity,
        source_url: source_url, redirect_hops: redirect_hops, redirect_target: redirect_target,
        depth: depth, outcome: outcome, content: content, tier: tier,
        etag: etag, last_modified: last_modified, sitemap_lastmod: sitemap_lastmod,
        raw_digest: raw_digest, status: pending
    )
}

rule RequestPass {
    when: PassRequested(operator, mirror, kind, run_id?)
    ensures: MirrorPass.created(
        mirror: mirror, operator: operator, kind: kind, run_id: run_id,
        failures: [], broken_links: [], status: pending
    )
}

------------------------------------------------------------
-- Ownership
------------------------------------------------------------

rule SaveOwnership {
    when: OperatorSavesOwnership(operator, mirror, hosts)
    requires: hosts.all(h => h in mirror.scope.allowed_hosts)
    ensures: mirror.declared_owned_hosts = hosts

    @guidance
        -- Saving declarations is an affirmative "I own these websites"
        -- configuration action, never permission to crawl a third party's
        -- website and never a run by itself. An empty set revokes the
        -- declarations. A host outside the allowed hosts is refused. Host
        -- names are normalised exactly as URL hosts, with no wildcard or
        -- inherited subdomain authority.
}

------------------------------------------------------------
-- Storing converted content
------------------------------------------------------------

rule RejectDuplicateCandidate {
    when: candidate: PageCandidate.created
    requires: candidate.status = pending and candidate.outcome = converted
    let identity = candidate.mirror.scope.page_identity(candidate.source_url, candidate.content?.canonical_url)
    let target = Page{mirror: candidate.mirror, identity: identity}
    requires: exists target and target.status = written and target.last_stored_run = candidate.run_id
    let previous = known_page(candidate.mirror, candidate.requested_identity)
    let scope = candidate.mirror.scope
    ensures:
        if exists previous and previous != target:
            PageRetired(page: previous, reason: merged)
        for hop in candidate.redirect_hops:
            if scope.identity_of(hop) != target.identity:
                AliasRecorded(mirror: candidate.mirror, url: scope.identity_of(hop), page: target)
        if scope.identity_of(candidate.source_url) != target.identity:
            AliasRecorded(mirror: candidate.mirror, url: scope.identity_of(candidate.source_url), page: target)
        if candidate.requested_identity != target.identity:
            AliasRecorded(mirror: candidate.mirror, url: candidate.requested_identity, page: target)
        candidate.status = duplicate
        CandidateDuplicate(candidate: candidate, page: target)

    @guidance
        -- Two requested URLs resolved to one identity in the same run (a
        -- redirect to a page already stored, or a canonical already
        -- honoured). The first store's content stands; this candidate's
        -- requested URL, redirect hops and source URL still become aliases
        -- of the stored page, and a written page the requested URL held
        -- is merged into it, exactly as a store would have done. Decided:
        -- when the two URLs' content differs, the content of the one
        -- fetched first stands, so the mirror is deterministic for a given
        -- frontier order, not for every order.
}

rule RewriteKnownPage {
    when: candidate: PageCandidate.created
    requires: candidate.status = pending and candidate.outcome = converted
    let identity = candidate.mirror.scope.page_identity(candidate.source_url, candidate.content?.canonical_url)
    let target = Page{mirror: candidate.mirror, identity: identity}
    let previous = known_page(candidate.mirror, candidate.requested_identity)
    requires: exists target and target.status = written and target.last_stored_run != candidate.run_id
    ensures:
        target.previous_digest = target.content_digest
        if exists previous and previous != target:
            PageRetired(page: previous, reason: merged)
        PageContentAccepted(candidate: candidate, page: target)

    @guidance
        -- The identity already has a written page: the requested page
        -- itself, or another page the new canonical names. In the second
        -- case the requested page is merged into the target: it is
        -- removed with reason merged and its URL becomes an alias of the
        -- target, so links to either URL resolve to one page file.
}

-- Default stated here (veto at review): the path follows the URL. When
-- the identity of a known page changes, the page keeps its record and
-- history, its path is reassigned, its file moves, and the run reports one
-- moved change carrying the old and the new path, never also added. No
-- stub is left at the old path; docs outside the mirror resolve the move
-- from git history.
rule MovePage {
    when: candidate: PageCandidate.created
    requires: candidate.status = pending and candidate.outcome = converted
    let identity = candidate.mirror.scope.page_identity(candidate.source_url, candidate.content?.canonical_url)
    let target = Page{mirror: candidate.mirror, identity: identity}
    let previous = known_page(candidate.mirror, candidate.requested_identity)
    requires: exists previous
    requires: not exists target or target.status = removed
    let old_path = previous.path
    let new_path = assign_path(candidate.mirror, identity)
    requires: new_path != null
    let stale = Alias{mirror: candidate.mirror, url: identity}
    ensures:
        if exists target:
            ArchivedCopyDeleted(mirror: candidate.mirror, path: target.path)
            not exists target
        if exists stale:
            not exists stale
        previous.identity = identity
        previous.previous_digest = previous.content_digest
        if new_path != old_path:
            previous.moved_from = old_path
            previous.path = new_path
            PageFileMoved(mirror: candidate.mirror, from_path: old_path, to_path: new_path)
        PageContentAccepted(candidate: candidate, page: previous)

    @guidance
        -- A removed record already holding the new identity is replaced:
        -- the live page supersedes it and its archived copy is deleted. An
        -- alias the new identity held is dropped, since a page's identity
        -- is never an alias. Decided: an alias URL rechecked
        -- (crawl/Enqueue) that now serves its own page moves the page it
        -- aliased here, as any requested URL whose known page answers
        -- under a new identity does.
        --
        -- assign_path gives "pages/", the host segment, "/" and a relative
        -- path. The host segment is the identity's host lower-cased, with a
        -- trailing "." dropped, every character outside [a-z0-9.-] replaced
        -- with "-", the device-name rewrite below applied, and a non-default
        -- port appended as "_<port>" (":" is illegal on Windows, and "_"
        -- appears in no sanitised host): example.com. gives example.com,
        -- con gives con-, con:8080 gives con-_8080 (the device rule runs
        -- before the port is appended), and [::1]:8080 gives ---1-_8080 (the
        -- rule reads an IPv6 host in its bracketed form, as written). A
        -- host too long to leave room for a page within max_path_chars has
        -- its pages refused (RefuseUnplaceableCandidate). Two hosts that
        -- sanitise alike share a host segment, and the collision step below
        -- keeps their paths apart. The relative path strips the scope
        -- prefix, names a directory URL "index" (so the scope root is
        -- pages/<host>/index.md; the root index.md is outside pages/ and
        -- never collides with it), drops a trailing .html, .htm or .aspx
        -- (ignoring case), names a last segment that drop leaves empty
        -- "index" as for a directory URL (under the prefix "/", /guide/.html
        -- gives pages/<host>/guide/index.md and /.html gives
        -- pages/<host>/index.md), appends the version label the profile maps,
        -- keeps [A-Za-z0-9._-] in each segment and replaces the rest with "-",
        -- drops empty segments (so "//" collapses), applies the segment
        -- rewrites below, and last appends ".md" unless the rewritten last
        -- segment already ends in ".md" exactly, in lower case, so an
        -- existing ".md" is not doubled and any other case is: README.md
        -- stays README.md, while README.MD gives README.MD.md.
        --
        -- The version label stays in the page path, outside the fixed
        -- template "pages/{host}/{path}". Its form (separator and position)
        -- is not yet specified, so a page whose path would carry a version
        -- label is not yet covered here.
        --
        -- Segment rewrites inside pages/<host>/. Each reads one sanitised
        -- segment alone and they apply together, so neither the crawl order
        -- nor their own order matters; where two rewrite the same character
        -- they agree. A trailing run of "." becomes "-", so a segment made
        -- only of dots becomes all "-". A leading "." becomes "-" (.git/ gives
        -- -git/, .rovo/ gives -rovo/), so no page is hidden. A directory
        -- segment equal, ignoring case, to a managed root file name
        -- (llms.txt, index.jsonl, links.jsonl, crawl-report.json, rovo.toml)
        -- has its last "." replaced with "-" (llms.txt/guide gives
        -- llms-txt/guide.md). A directory segment ending in .md (ignoring
        -- case) has its final "." replaced with "-" (a.md/x gives a-md/x.md
        -- and A.MD/x gives A-MD/x.md), since a page file is never also a
        -- directory. A segment whose part before its first "." is a device
        -- name (CON, PRN, AUX, NUL, COM1 to COM9, LPT1 to LPT9), ignoring
        -- case, has "-" appended to that part, before the first ".", since
        -- Windows reserves a name by that part: con gives con- (the page
        -- con-.md), con.txt gives con-.txt, and NUL.json/x gives
        -- NUL-.json/x.md.
        --
        -- No segment equal to _removed is rewritten any more: the archive
        -- is _removed/ at the mirror's root, a sibling of pages/, so no page
        -- path can reach it, nor _indexes/, .rovo/ or a managed root file.
        -- No name is reserved inside pages/<host>/: _index.md and index.md
        -- there are ordinary page names.
        --
        -- Decided: each directory segment below pages/<host>/ is then
        -- folded, ignoring case, onto the spelling that a path a page
        -- holds (this page's own included) already uses for that
        -- directory, so a directory has one spelling across
        -- the manifest, the tree, index.jsonl and links: with
        -- pages/<host>/sub/a.md held, /Sub/b gives pages/<host>/sub/b.md,
        -- and a page at sub/x.md whose URL becomes /Sub/x keeps sub/x.md.
        -- Where held paths already use several spellings of one directory,
        -- the spelling of the held path that sorts first by code point is
        -- taken; existing pages are not moved.
        -- The last segment, the page file's name, keeps its own spelling
        -- and meets the collision test below (UniquePagePathIgnoringCase).
        --
        -- A candidate path held by another page (compared ignoring case,
        -- because a case-insensitive file system holds API/ and api/ as one
        -- directory) or longer than max_path_chars becomes a stem cut to
        -- max_path_chars - 10, "-", and the first collision_hash_chars hex of
        -- the identity's digest; the suffix depends on the identity alone,
        -- never on crawl order. When that suffixed path is itself held
        -- (ignoring case) or too long, the suffix is the full 64-hex digest
        -- instead, with the stem cut so the result still fits max_path_chars.
        -- max_path_chars counts the whole mirror-relative path, pages/<host>/
        -- included, since that is what meets a file system's limits. A cut
        -- never shortens pages/<host>/: an option whose prefix and suffix do
        -- not fit is unusable. When the full-digest path is unusable too,
        -- assign_path is null: the candidate is refused
        -- (RefuseUnplaceableCandidate) and nothing in the mirror changes.
}

-- Default stated here (veto at review): a removed page that answers again
-- is written again at a path for its current URL, which is its old path
-- when that is still free, and the run reports it added. Its archived copy
-- leaves the removed area.
rule ReviveRemovedPage {
    when: candidate: PageCandidate.created
    requires: candidate.status = pending and candidate.outcome = converted
    let identity = candidate.mirror.scope.page_identity(candidate.source_url, candidate.content?.canonical_url)
    let target = Page{mirror: candidate.mirror, identity: identity}
    let previous = known_page(candidate.mirror, candidate.requested_identity)
    requires: not exists previous
    requires: exists target and target.status = removed
    let archived_path = target.path
    let new_path = assign_path(candidate.mirror, identity)
    requires: new_path != null
    ensures:
        target.status = written
        target.removed_at = null
        target.removal_reason = null
        target.redirect_target = null
        target.path = new_path
        target.revived_from = archived_path
        target.previous_digest = null
        target.first_seen = now
        ArchivedCopyDeleted(mirror: candidate.mirror, path: archived_path)
        PageContentAccepted(candidate: candidate, page: target)
}

rule StoreNewPage {
    when: candidate: PageCandidate.created
    requires: candidate.status = pending and candidate.outcome = converted
    let identity = candidate.mirror.scope.page_identity(candidate.source_url, candidate.content?.canonical_url)
    let target = Page{mirror: candidate.mirror, identity: identity}
    let previous = known_page(candidate.mirror, candidate.requested_identity)
    requires: not exists previous
    requires: not exists target
    let content = candidate.content
    requires: content != null
    let new_path = assign_path(candidate.mirror, identity)
    requires: new_path != null
    ensures:
        Page.created(
            mirror: candidate.mirror, identity: identity,
            path: new_path,
            canonical_url: content.canonical_url, source_url: candidate.source_url,
            title: content.title, description: content.description,
            method: content.method, tier: candidate.tier,
            quality: content.quality, flags: content.quality.flags,
            low_confidence: content.quality.low_confidence,
            anchors: content.anchors, headings: content.headings, keywords: [],
            breadcrumbs: content.breadcrumbs,
            locale: candidate.mirror.scope.locale ?? content.declared_locale,
            version: version_label(candidate.mirror.profile, identity),
            raw_digest: candidate.raw_digest,
            content_digest: digest(content.body), previous_digest: null, moved_from: null, revived_from: null,
            etag: candidate.etag, last_modified: candidate.last_modified,
            sitemap_lastmod: candidate.sitemap_lastmod,
            processing_signature: candidate.mirror.processing_signature,
            converted_body: content.body, body: content.body, frontmatter: null,
            last_outcome: added, last_seen_run: candidate.run_id, last_stored_run: candidate.run_id,
            first_seen: now, fetched_at: now, last_seen: now, last_changed: now,
            status: written, redirect_target: null
        )
        PageContentAccepted(candidate: candidate, page: Page{mirror: candidate.mirror, identity: identity})

    @guidance
        -- The page is created with provisional content fields; the shared
        -- RefreshPage rule below sets them for every stored candidate, new
        -- or known, so there is one definition of what a store writes.
        -- version_label maps the identity's version parameter through the
        -- profile's version map and is null when the profile has no
        -- version parameter.
}

-- A candidate that needs a path (a new page, a move or a revival) and
-- gets none from assign_path is refused: it is discarded, so the crawl
-- fails its entry and the run reports the URL as failed. The page a move
-- would have moved keeps its identity and path, a removed record stays
-- removed, no alias is recorded and no links are queued.
rule RefuseUnplaceableCandidate {
    when: candidate: PageCandidate.created
    requires: candidate.status = pending and candidate.outcome = converted
    let identity = candidate.mirror.scope.page_identity(candidate.source_url, candidate.content?.canonical_url)
    let target = Page{mirror: candidate.mirror, identity: identity}
    requires: not exists target or target.status = removed
    requires: assign_path(candidate.mirror, identity) = null
    ensures:
        candidate.status = accepted
        CandidateDiscarded(candidate: candidate, reason: "no free path")
}

-- Shared effects of every store. The page's links are dropped and
-- re-resolved at finalisation, so the link flags and low-confidence
-- verdict are provisional until then.
rule RefreshPage {
    when: PageContentAccepted(candidate, page)
    requires: candidate.status = pending
    let content = candidate.content
    requires: content != null
    ensures:
        page.canonical_url = content.canonical_url
        page.source_url = candidate.source_url
        page.title = content.title
        page.description = content.description
        page.method = content.method
        page.tier = candidate.tier
        page.quality = content.quality
        page.flags = content.quality.flags
        page.low_confidence = content.quality.low_confidence
        page.anchors = content.anchors
        page.headings = content.headings
        page.breadcrumbs = content.breadcrumbs
        page.locale = candidate.mirror.scope.locale ?? content.declared_locale
        page.version = version_label(candidate.mirror.profile, page.identity)
        page.raw_digest = candidate.raw_digest
        page.etag = candidate.etag
        page.last_modified = candidate.last_modified
        page.sitemap_lastmod = candidate.sitemap_lastmod
        page.processing_signature = candidate.mirror.processing_signature
        page.converted_body = content.body
        page.last_seen_run = candidate.run_id
        page.last_stored_run = candidate.run_id
        page.fetched_at = now
        page.last_seen = now
        for l in page.outbound_links:
            not exists l
        for hop in candidate.redirect_hops:
            if candidate.mirror.scope.identity_of(hop) != page.identity:
                AliasRecorded(mirror: candidate.mirror, url: candidate.mirror.scope.identity_of(hop), page: page)
        if candidate.mirror.scope.identity_of(candidate.source_url) != page.identity:
            AliasRecorded(mirror: candidate.mirror, url: candidate.mirror.scope.identity_of(candidate.source_url), page: page)
        if candidate.requested_identity != page.identity:
            AliasRecorded(mirror: candidate.mirror, url: candidate.requested_identity, page: page)
        candidate.status = accepted
        PageStored(candidate: candidate, page: page)
        LinksFound(candidate: candidate, page: page, depth: candidate.depth, targets: content.link_targets, navigation_targets: content.navigation_targets)

    @guidance
        -- No file is written here. Page files are written at finalisation,
        -- after link rewriting, and only when their text would differ; an
        -- interrupted run therefore leaves no half-published page, and the
        -- next finalisation writes whatever is missing. Every URL on the
        -- way to the page becomes an alias: the requested identity, each
        -- redirect hop and the final source URL when a canonical moved the
        -- identity past it, all as identities, so a link to any of them
        -- resolves to the one page file.
}

-- Default stated here (veto at review): an alias resolves to the final
-- identity, follows the page through a move and is dropped with the page.
-- A URL that is itself a written page's identity is never an alias; a
-- removed page's URL may be, so a URL merged into another page keeps
-- resolving to the page that survived.
rule RecordAlias {
    when: AliasRecorded(mirror, url, page)
    let own = Page{mirror: mirror, identity: url}
    requires: not exists own or own.status = removed
    let alias = Alias{mirror: mirror, url: url}
    ensures:
        if exists alias:
            alias.target = page
        else:
            Alias.created(mirror: mirror, url: url, target: page)
}

rule DropAliasOfOwnIdentity {
    when: AliasRecorded(mirror, url, page)
    let own = Page{mirror: mirror, identity: url}
    requires: exists own and own.status = written
    let stale = Alias{mirror: mirror, url: url}
    ensures:
        if exists stale:
            not exists stale
}

------------------------------------------------------------
-- Unchanged, absent and redirected candidates
------------------------------------------------------------

rule RecordUnchanged {
    when: candidate: PageCandidate.created
    requires: candidate.status = pending and candidate.outcome = unchanged
    let previous = known_page(candidate.mirror, candidate.requested_identity)
    requires: exists previous
    ensures:
        previous.last_seen = now
        previous.last_seen_run = candidate.run_id
        previous.etag = candidate.etag ?? previous.etag
        previous.last_modified = candidate.last_modified ?? previous.last_modified
        previous.sitemap_lastmod = candidate.sitemap_lastmod ?? previous.sitemap_lastmod
        candidate.status = accepted
        PageStored(candidate: candidate, page: previous)

    @guidance
        -- A not-modified answer or an unchanged raw document. The page
        -- file is untouched; the stored measurement is carried, not
        -- re-measured. Taking the entry's sitemap lastmod means the same
        -- lastmod does not force a refetch again; a lastmod that moved
        -- reaches the frontmatter, so PublishPage rewrites the page file
        -- (Frontmatter). The new etag and
        -- last_modified are kept in the manifest only (Frontmatter). The
        -- page's stored links are queued again by the crawl
        -- (crawl/RefollowUnchangedLinks, on PageStored) unless the run
        -- turns that off; no LinksFound is raised here.
}

rule DiscardUnchangedWithoutPage {
    when: candidate: PageCandidate.created
    requires: candidate.status = pending and candidate.outcome = unchanged
    requires: not exists known_page(candidate.mirror, candidate.requested_identity)
    ensures:
        candidate.status = accepted
        CandidateDiscarded(candidate: candidate, reason: "no page to confirm")
}

-- Default stated here (veto at review): a 404 or 410 removes the written
-- page; on a URL with no written page it is a no-op recheck.
rule RemoveAbsentPage {
    when: candidate: PageCandidate.created
    requires: candidate.status = pending and candidate.outcome = absent
    let previous = known_page(candidate.mirror, candidate.requested_identity)
    requires: exists previous
    ensures:
        candidate.status = accepted
        PageRetired(page: previous, reason: absent, candidate: candidate)
}

rule AcceptAbsentWithoutPage {
    when: candidate: PageCandidate.created
    requires: candidate.status = pending and candidate.outcome = absent
    requires: not exists known_page(candidate.mirror, candidate.requested_identity)
    ensures: candidate.status = accepted
}

-- Default stated here (veto at review): a known page that now redirects
-- out of scope is removed and the target is recorded on its record.
rule RemoveRedirectedOutPage {
    when: candidate: PageCandidate.created
    requires: candidate.status = pending and candidate.outcome = redirected_out
    let previous = known_page(candidate.mirror, candidate.requested_identity)
    requires: exists previous
    ensures:
        candidate.status = accepted
        PageRetired(page: previous, reason: redirected_out, redirect_target: candidate.redirect_target, candidate: candidate)
}

rule AcceptRedirectedOutWithoutPage {
    when: candidate: PageCandidate.created
    requires: candidate.status = pending and candidate.outcome = redirected_out
    requires: not exists known_page(candidate.mirror, candidate.requested_identity)
    ensures: candidate.status = accepted
}

------------------------------------------------------------
-- Removal
------------------------------------------------------------

-- Every removal goes through here: the page keeps its record and path,
-- its aliases and links go, and its file is archived, or deleted when
-- prune is set. A page revived in this run is retired at the path it was
-- revived from, where its archived copy is, unless another page now holds
-- that path; then the copy moves to the page's new path. The archive mirrors pages/:
-- the file at pages/<host>/<relative path> is archived at
-- _removed/<host>/<relative path>, and that is the archived copy
-- ArchivedCopyDeleted names by the page's path.
rule RetirePage {
    when: PageRetired(page, reason, redirect_target?, candidate?)
    requires: page.status = written
    let old_path_held =
        page.revived_from != null
        and page.mirror.pages.any(p => p != page and casefold(p.path) = casefold(page.revived_from))
    let retired_path = if page.revived_from = null or old_path_held: page.path else: page.revived_from
    ensures:
        page.status = removed
        page.removed_at = now
        page.removal_reason = reason
        page.redirect_target = redirect_target
        page.moved_from = null
        page.revived_from = null
        page.path = retired_path
        for a in page.aliases:
            not exists a
        for l in page.outbound_links:
            not exists l
        if config.prune:
            PageFileDeleted(mirror: page.mirror, path: retired_path)
        else:
            if old_path_held:
                ArchivedCopyMoved(mirror: page.mirror, from_path: page.revived_from, to_path: retired_path)
            PageFileArchived(mirror: page.mirror, path: retired_path)
        PageRemoved(mirror: page.mirror, page: page, reason: reason, candidate: candidate)

    @guidance
        -- Pages that linked here keep their links until the next
        -- finalisation re-resolves them as dangling. The first removal is
        -- kept: a removed page is never reported removed again.
        --
        -- Decided: the file effects (PageFileMoved, PageFileArchived,
        -- PageFileDeleted, ArchivedCopyDeleted, ArchivedCopyMoved) are
        -- recorded when their rule fires at intake and applied in the
        -- finalise pass, in the order raised and idempotently, before any
        -- PublishPage. Pending
        -- effects compose per page path: a page moved, once or more, and
        -- then retired in the same run is archived from the path it was
        -- last published at to _removed/<host>/<the path it was retired
        -- at>, or under prune that file is deleted; a removed page revived
        -- and retired again in the same run keeps its archived copy, the
        -- PageFileArchived cancelling the pending ArchivedCopyDeleted of
        -- that path and archiving nothing. Decided: a removed page revived
        -- at a new path (its old one no longer free) and retired again in
        -- the same run likewise keeps its existing _removed/ copy, its
        -- last published bytes: its record returns to the old path, the
        -- path that copy is at (revived_from), so the PageFileArchived of
        -- that path cancels the pending ArchivedCopyDeleted, the
        -- never-published new path is not archived, nothing moves on disk
        -- and the record and its copy agree (RemovedAreaKeepsPath).
        -- Decided: when another page has taken that old path in the same
        -- run, the record keeps its new path and the kept copy moves from
        -- _removed/<host>/<old path> to _removed/<host>/<new path>
        -- (ArchivedCopyMoved), which cancels the pending ArchivedCopyDeleted
        -- of the old path; the PageFileArchived of the never-published new
        -- path archives nothing, so record and copy still agree and
        -- UniquePagePathIgnoringCase holds. Under prune nothing moves: the
        -- pending ArchivedCopyDeleted deletes the copy. A directory under
        -- pages/ or _removed/ that an effect leaves empty is removed, the
        -- namespace root (pages/ or _removed/) included.
}

------------------------------------------------------------
-- Finalisation: scope, links and bodies
------------------------------------------------------------

-- Default stated here (veto at review): a page whose source URL falls
-- outside the scope in force is removed, whatever its content, at the
-- first finalisation that follows a run which did not store it. The source
-- URL is measured, never the identity, so a page stored under a canonical
-- outside the path prefixes stays as long as its source is in scope; a
-- page the operator named outside the scope is published by the run that
-- fetched it and removed by the next full run.
rule RetireOutOfScopePages {
    when: pass: MirrorPass.created
    requires: pass.status = pending
    requires: pass.kind = finalise
    ensures:
        for p in pass.mirror.written_pages:
            if not pass.mirror.scope.within_bounds(p.source_url)
                and (pass.run_id = null or p.last_stored_run != pass.run_id):
                PageRetired(page: p, reason: out_of_scope)
        ScopeSettled(pass: pass)
}

-- Every finalisation resolves the links of every written page against the
-- complete set of written pages, so redirects, removals and new pages are
-- reflected in every page, not only the refetched ones.
rule ResolveMirrorLinks {
    when: ScopeSettled(pass)
    requires: pass.status = pending
    ensures:
        for page in pass.mirror.written_pages:
            for l in page.outbound_links:
                not exists l
            for d in link_destinations(page.converted_body):
                DestinationFound(pass: pass, page: page, target: d.target, fragment: d.fragment)
            PageLinksResolved(pass: pass, page: page)
        MirrorLinksResolved(pass: pass)

    @guidance
        -- link_destinations lists every link (target as written, fragment)
        -- outside frontmatter, fenced code, inline code and pre or code
        -- blocks; images, empty targets
        -- and non-web targets (mailto:, tel:, javascript:, data:) are left
        -- as written and never become links. Every page's destinations are
        -- resolved and every page's body finalised before
        -- MirrorLinksResolved is handled.
}

-- The destination is made absolute against the page's source URL and
-- normalised to an identity. A written page holding it, directly or
-- through an alias, makes the link internal.
rule LinkToPage {
    when: DestinationFound(pass, page, target, fragment?)
    let identity = page.mirror.scope.identity_of(resolve_url(page.source_url, target))
    let holder = known_page(page.mirror, identity)
    requires: exists holder
    ensures: Link.created(
        source: page, target_identity: identity, fragment: fragment,
        kind: internal, target: holder,
        fragment_resolved: fragment = null or fragment in holder.anchors
    )
}

rule LinkToRemovedPage {
    when: DestinationFound(pass, page, target, fragment?)
    let identity = page.mirror.scope.identity_of(resolve_url(page.source_url, target))
    requires: not exists known_page(page.mirror, identity)
    let holder = Page{mirror: page.mirror, identity: identity}
    requires: exists holder and holder.status = removed
    ensures: Link.created(
        source: page, target_identity: identity, fragment: fragment,
        kind: dangling, target: null, fragment_resolved: true
    )
}

rule LinkToUncrawledPage {
    when: DestinationFound(pass, page, target, fragment?)
    let identity = page.mirror.scope.identity_of(resolve_url(page.source_url, target))
    requires: not exists known_page(page.mirror, identity)
    requires: not exists Page{mirror: page.mirror, identity: identity}
    requires: page.mirror.scope.within_bounds(identity)
    ensures: Link.created(
        source: page, target_identity: identity, fragment: fragment,
        kind: uncrawled, target: null, fragment_resolved: true
    )
}

rule LinkToExternalPage {
    when: DestinationFound(pass, page, target, fragment?)
    let identity = page.mirror.scope.identity_of(resolve_url(page.source_url, target))
    requires: identity != null
    requires: not exists known_page(page.mirror, identity)
    requires: not exists Page{mirror: page.mirror, identity: identity}
    requires: not page.mirror.scope.within_bounds(identity)
    ensures: Link.created(
        source: page, target_identity: identity, fragment: fragment,
        kind: external, target: null, fragment_resolved: true
    )
}

-- A destination whose identity identity_of cannot compute (a port out of
-- range, say) satisfies none of the four rules above: it records no Link,
-- feeds no link flag, and rewrite_destinations leaves it as written, byte
-- for byte.

-- The body is the converted body with each internal destination replaced
-- by a relative path plus its fragment (a self-link with a fragment becomes
-- a bare fragment) and every other destination left absolute. The relative
-- path runs from the linking file to the target file within pages/, so a
-- link to another host's page climbs to pages/ and descends again
-- (pages/a.example/guide/x.md links to pages/b.example/y.md as
-- ../../b.example/y.md). Every other
-- byte, code samples included, is untouched. Link flags, keywords and the
-- low-confidence verdict are recomputed from scratch.
rule FinalisePageBody {
    when: PageLinksResolved(pass, page)
    let body = rewrite_destinations(page.converted_body, page)
    let link_flags =
        (if page.has_uncrawled_link: { uncrawled_internal } else: {})
        + (if page.has_unresolved_fragment: { unresolved_fragment } else: {})
        + (if page.has_dangling_link: { dangling_inbound } else: {})
    ensures:
        page.body = body
        page.content_digest = digest(body)
        page.flags = page.quality.flags + link_flags
        page.low_confidence = page.quality.low_confidence or link_flags.any(f => f in convert/config.incomplete_flags)
        page.keywords = keywords_of(body, config.keywords_per_page, config.keywords_min)
        PageBodyFinalised(pass: pass, page: page)

    @guidance
        -- keywords_of returns up to keywords_per_page distinctive terms of
        -- one body, topped up to keywords_min when the body allows, and
        -- depends on nothing but that body, so an unchanged page keeps its
        -- keywords. rewrite_destinations is idempotent.
}

-- Default stated here (veto at review): the published body's digest alone
-- decides whether a page is added, changed or unchanged; a move is one
-- moved change; a page file is written only when its text would differ
-- from the file on disk.
rule PublishPage {
    when: PageBodyFinalised(pass, page)
    let outcome =
        if page.was_moved: moved
        else if page.is_new_this_run: added
        else if page.previous_digest != page.content_digest: changed
        else: unchanged
    let previous_path = page.moved_from
    ensures:
        page.frontmatter = frontmatter_of(page)
        page.last_outcome = outcome
        if outcome != unchanged:
            page.last_changed = now
        page.previous_digest = page.content_digest
        page.moved_from = null
        page.revived_from = null
        if not page_file_current(page):
            PageFileWritten(mirror: page.mirror, page: page)
        PageFinalised(
            pass: pass, page: page, outcome: outcome, previous_path: previous_path,
            seen_this_run: page.last_seen_run = pass.run_id
        )

    @guidance
        -- frontmatter_of takes the page's current fields. page_file_current
        -- is true when the page file exists and its text equals the
        -- frontmatter followed by the body; a file written is replaced
        -- atomically. previous_path is the old path of a moved page.
}

------------------------------------------------------------
-- Finalisation: indexes
------------------------------------------------------------

rule FinishLinkPass {
    when: MirrorLinksResolved(pass)
    requires: pass.status = pending
    ensures:
        pass.broken_links = find_broken_links(pass.mirror)
        LinksRewritten(mirror: pass.mirror, pass: pass, operator: pass.operator, broken: find_broken_links(pass.mirror))
        IndexBuildDue(pass: pass)

    @guidance
        -- find_broken_links lists every relative destination in a page
        -- file that leaves the mirror, reaches no file, or names a
        -- fragment absent from the target file, unless the page's internal
        -- Link to that file records the fragment unresolved
        -- (fragment_resolved false: the anchor is absent upstream, and
        -- unresolved_fragment already reports it). A missing page file is
        -- one BrokenLink: from_path the page's path, href "" and reason
        -- missing_file. After a complete finalisation it is empty; a
        -- non-empty list means a file could not be written.
}

rule RebuildIndexes {
    when: pass: MirrorPass.created
    requires: pass.status = pending
    requires: pass.kind = index
    ensures: IndexBuildDue(pass: pass)
}

-- Index outputs are a pure function of the written pages, their links and
-- config: rebuilding from unchanged input leaves every output
-- byte-identical, and no index carries wall-clock time.
rule BuildIndexes {
    when: IndexBuildDue(pass)
    requires: pass.status = pending
    let mirror = pass.mirror
    let entries = index_entries(mirror.written_pages)
    let link_entries = link_index_entries(mirror.written_pages, mirror.aliases)
    let index = mirror.index
    ensures:
        if exists index:
            index.entries = entries
            index.link_entries = link_entries
            index.directory_indexes = directory_indexes_for(entries, config.hierarchical_index_threshold)
            index.summary = llms_summary(mirror, entries)
        else:
            Index.created(
                mirror: mirror, entries: entries, link_entries: link_entries,
                directory_indexes: directory_indexes_for(entries, config.hierarchical_index_threshold),
                summary: llms_summary(mirror, entries)
            )
        IndexFilesWritten(mirror: mirror)
        pass.status = completed
        IndexesWritten(mirror: mirror, pass: pass, operator: pass.operator)

    @guidance
        -- index_entries makes one IndexEntry per written page in path
        -- order, every field from the manifest: word_count is the number
        -- of words the quality measurement counted outside code (the
        -- length of quality.output.words), and outbound_internal and
        -- inbound_internal count the page's internal links over
        -- Mirror.links.
        --
        -- The Markdown indexes (index.md, llms.txt and the directory
        -- indexes) are blocks of lines, one blank line between two
        -- blocks; an empty block is left out. A page line is
        -- "- [<title>](<link>)", followed by " (low confidence)" when the
        -- page is low_confidence; a directory-index line is
        -- "- [<heading>](<link>)". A title entering link text has each
        -- "\", "[" and "]" escaped with a backslash, and each newline or
        -- run of whitespace in it becomes one space. Nearest first means
        -- the shallower directory first, then by path.
        --
        -- index.md is "# Index", then for each host segment in name order
        -- "## <host>" and the host's top-level pages (directly under
        -- pages/<host>/) in path order, then for each top-level directory
        -- of that host in name order "### <dir>", the directory indexes at
        -- or below it, nearest first, then every page below it in path
        -- order, the pages of a directory with its own index included.
        -- The <dir> of "### <dir>" is the directory's name lower-cased,
        -- and the directories are ordered by it, so top-level directories
        -- that differ only in case share one heading. A mirror with no page
        -- writes "# Index" alone.
        --
        -- A directory below a host's top level holding more than
        -- hierarchical_index_threshold pages (counted directly, not
        -- recursively, directories that differ only in case counted as
        -- one) gets its own file under _indexes/<host>/, named as
        -- DirectoryIndex states. Its text is "# <heading>", then a line
        -- for each of its nearest indexed descendants, nearest first: the
        -- indexes of the directories below its own, skipping any
        -- directory without an index of its own
        -- (_indexes/<host>/api.md links _indexes/<host>/api/v2.md, or
        -- _indexes/<host>/api/v2/ref.md when api/v2 has no index), then a
        -- line for each of its own pages in path order. index.md links
        -- every directory index, so none is orphaned. A host's top level
        -- gets no directory index.
        --
        -- llms.txt is "# <host>" of the first page by path ("# Index" for
        -- an empty mirror), then "> <summary>" unless the summary is
        -- empty, then one page line per page in path order. Past
        -- llms_txt_cap, when the written pages number more than the cap,
        -- a directory that has its own directory index is listed as one
        -- directory-index line, in the place of its first page in path
        -- order, instead of its pages; a host's top-level pages and the
        -- pages of a directory without an index of its own are still
        -- listed one by one.
        --
        -- llms_summary is the description of the page whose identity, or
        -- one of whose aliases, is the identity of a start URL (the first
        -- such start URL in the scope's order), else of the page the root
        -- URL's identity or alias names, else of the first page by path;
        -- the empty string for an empty mirror.
        --
        -- links.jsonl holds one LinkIndexEntry per cited identity,
        -- without fragment, sorted by URL, with the kind link resolution
        -- gave it and the citing pages' paths sorted. index.jsonl and
        -- links.jsonl hold one JSON object per line: keys sorted, compact
        -- separators ("," and ":"), non-ASCII characters written as
        -- themselves, a set as a sorted list, an enum value (kind, each
        -- quality flag) as its name, an absent optional value as null,
        -- and a line feed after every line, so an empty mirror
        -- writes an empty file.
        --
        -- Every path an index holds is mirror-relative (pages/<host>/...),
        -- and every link it holds is relative to the index file: index.md
        -- and llms.txt link down into pages/ and _indexes/, a file under
        -- _indexes/<host>/ links up and back down into pages/<host>/.
        -- Stale files under _indexes/ are deleted. Index files are written
        -- only when their text would differ.
}

------------------------------------------------------------
-- Verification
------------------------------------------------------------

-- Default stated here (veto at review): verify reports drift from the
-- recorded result, not the recorded result again; a fragment resolves
-- when the target file holds the anchor; the generated indexes are checked
-- too.
rule VerifyPages {
    when: pass: MirrorPass.created
    requires: pass.status = pending
    requires: pass.kind = verify
    let failures = verification_failures(pass.mirror)
    ensures:
        pass.failures = failures
        pass.status = completed
        VerificationFinished(mirror: pass.mirror, pass: pass, operator: pass.operator, failures: failures)

    @guidance
        -- verification_failures is offline and never contacts the site. It
        -- reports: a written page whose file is missing (missing_file); a
        -- Markdown file under pages/ that the manifest does not know, or
        -- under _indexes/ that BuildIndexes would not write
        -- (unmanaged_file), while anything else at the mirror's root that
        -- is not a managed file (.git/, a README) is the operator's and is
        -- never reported; a page file
        -- without the required frontmatter keys or that does not parse
        -- (invalid_page_file); a body whose digest differs from the
        -- frontmatter's or the manifest's content_digest
        -- (digest_mismatch); a gate that fails on the current body against
        -- the stored expected counts but did not fail when the page was
        -- measured (quality_drift); a relative link in a page file or a
        -- generated index that leaves the mirror, reaches no file, or
        -- names a fragment the target file does not hold (broken_link);
        -- an index file whose text differs from what BuildIndexes would
        -- write (index_stale).
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant UniquePageIdentity {
    for a in Pages:
        for b in Pages:
            a != b and a.mirror = b.mirror implies a.identity != b.identity
}

-- Paths are unique ignoring case, so the mirror is portable to
-- case-insensitive file systems; a directory's spelling is shared by
-- every path through it (assign_path, MovePage's guidance).
invariant UniquePagePathIgnoringCase {
    for a in Pages:
        for b in Pages:
            a != b and a.mirror = b.mirror implies casefold(a.path) != casefold(b.path)
}

-- Every page path lies in its host's namespace, pages/<host>/, where
-- page_root(identity) is "pages/", the host segment and "/", so no page
-- path can reach a managed root file, _removed/, _indexes/ or .rovo/.
-- segments_below(path, root) lists the segments of path after root, and
-- directory_segments_below all of them but the last. Inside the namespace
-- no segment is empty or hidden, none ends in ".", and no directory
-- segment is, ignoring case, a managed root file name or ends in ".md".
-- No segment under pages/, the host segment included, is a device name:
-- stem_before_first_dot(s) is the part of s before its first ".", or s.
invariant PagePathsAvoidManagedNames {
    for p in Pages:
        starts_with(p.path, page_root(p.identity))
        and ends_with(p.path, ".md")
        and segments_below(p.path, "pages/").all(s =>
            casefold(stem_before_first_dot(s)) not in {
                "con", "prn", "aux", "nul",
                "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9",
                "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9" })
        and segments_below(p.path, page_root(p.identity)).all(s =>
            s != "" and not starts_with(s, ".") and not ends_with(s, "."))
        and directory_segments_below(p.path, page_root(p.identity)).all(d =>
            casefold(d) not in { "llms.txt", "index.jsonl", "links.jsonl", "crawl-report.json", "rovo.toml" }
            and not ends_with(casefold(d), ".md"))
}

-- max_path_chars counts the whole mirror-relative path, pages/<host>/
-- included. Its range leaves room for pages/, a host segment and the
-- full-digest fallback ("-", 64 hex and ".md" make 68) and stays under the
-- common 255-byte name and 260-char path limits. It is the mirror's own
-- parameter, not a rovo.toml key. A page that still cannot fit is refused
-- (RefuseUnplaceableCandidate).
invariant MaxPathCharsInRange {
    config.max_path_chars >= 128 and config.max_path_chars <= 240
}

invariant OneAliasPerUrl {
    for a in Aliases:
        for b in Aliases:
            a != b and a.mirror = b.mirror implies a.url != b.url
}

invariant AliasesPointAtWrittenPages {
    for a in Aliases:
        a.target.status = written
}

invariant PageProcessedUnderOneSignature {
    for p in Pages:
        p.last_stored_run <= p.last_seen_run
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- What the mirror on disk promises whoever reads it: the operator, a diff,
-- an agent, or documentation outside the mirror that links into it.
surface MirrorContents {
    facing operator: Operator
    context mirror: Mirror

    exposes:
        mirror.out_dir
        mirror.scope
        mirror.profile.name
        mirror.declared_owned_hosts
        mirror.recorded_root_url
        mirror.processing_signature
        mirror.is_populated
        mirror.has_declared_owner
        mirror.page_paths
        for p in mirror.written_pages:
            p.identity
            p.path
            p.frontmatter
            p.body
            p.flags
            p.low_confidence
            p.last_outcome
            p.outbound_internal
            p.inbound_internal
        for r in mirror.removed_pages:
            r.path
            r.removed_at
            r.removal_reason
            r.redirect_target
        mirror.index?.entries
        mirror.index?.link_entries
        mirror.index?.directory_indexes
        mirror.index?.summary

    provides:
        OperatorSavesOwnership(operator, mirror, hosts)
        PassRequested(operator, mirror, kind, run_id?)

    @guarantee PageFileProvenance
        -- Every page file starts with YAML frontmatter whose keys are
        -- sorted. It always carries source_url, title, content_digest,
        -- quality_score, low_confidence, quality_flags, tier, method,
        -- profile and keywords; description, canonical_url, breadcrumbs,
        -- sitemap_lastmod, version and locale appear only when they have a
        -- value. The content digest covers the body after the frontmatter
        -- only, so a frontmatter edit never moves it. No page file carries
        -- a wall-clock time or the site's validators (etag and
        -- last_modified), which are kept in the mirror's state under .rovo/
        -- alone.

    @guarantee RelativeLinksOnly
        -- A link to a written page is a relative path from the linking
        -- file, plus its fragment, so the mirror links to itself and
        -- documentation outside the mirror can link to a page file and a
        -- heading fragment. Page files live under pages/<host>/, so a link
        -- between hosts climbs to pages/ (../../other.host/x.md) and a
        -- generated index links down into pages/. A fragment is defined by
        -- the anchors the target file holds. Every other link stays
        -- absolute.

    @guarantee UnchangedRunIsStable
        -- A sync against an unchanged site rewrites no page file and no
        -- index file: change detection, keywords, frontmatter and indexes
        -- are pure functions of the page bodies, links and configuration,
        -- and no generated file carries a wall-clock time or the site's
        -- validators, so a validator that moves over an unchanged body
        -- rewrites nothing; a sitemap lastmod that moves is a change
        -- upstream and rewrites its page's frontmatter. A diff of the
        -- mirror after a sync therefore shows only what changed upstream.

    @guarantee DeterministicIndexes
        -- Rebuilding the indexes from unchanged input leaves every output
        -- byte-identical; entries are sorted by path and link entries by
        -- URL; files are LF-terminated UTF-8.

    @guarantee CodeSamplesNeverRewritten
        -- Destinations in frontmatter, fenced code, inline code and pre or
        -- code blocks are never rewritten or verified.

    @guarantee RemovedAreaKeepsPath
        -- A removed page's file is archived under _removed/, a sibling of
        -- pages/ at the mirror's root that mirrors it: pages/<host>/<path>
        -- is archived at _removed/<host>/<path> unless prune deletes it,
        -- and the page keeps its record and path, so a return restores it
        -- in place.

    @guarantee FixedLayout
        -- Collected pages live under pages/<host>/ only and never beside a
        -- managed file or another tool's file; the managed files (rovo.toml,
        -- crawl-report.json, index.md, index.jsonl, links.jsonl, llms.txt
        -- and .rovo/) stay at the mirror's root with _removed/ and
        -- _indexes/. The layout is fixed: no configuration changes it.

    @guarantee OwnershipIsADeclaration
        -- Saving ownership records the operator's statement and nothing
        -- more: it is not verified, it enables no run, and it names only
        -- hosts the scope allows; any other host is refused.
}

-- What the crawl may deliver and what the mirror does with it.
surface PageIntake {
    facing run: SyncRun
    context mirror: Mirror

    exposes:
        run.id
        mirror.scope
        mirror.processing_signature
        for p in mirror.written_pages:
            p.identity
            p.raw_digest
            p.etag
            p.last_modified
            p.sitemap_lastmod
            p.processing_signature
            p.low_confidence
            for l in p.outbound_links:
                l.target_identity

    provides:
        CandidateDelivered(run, mirror, requested_identity, source_url, redirect_hops, redirect_target?, depth, outcome, content?, tier, etag?, last_modified?, sitemap_lastmod?, raw_digest)

    @guarantee EveryCandidateIsSettled
        -- Every delivered candidate is accepted or marked a duplicate in
        -- the same step, and at most one of PageStored, CandidateDuplicate,
        -- CandidateDiscarded or PageRemoved follows it, so the run can
        -- settle the frontier entry it came from. Exactly one follows
        -- every candidate but those AcceptAbsentWithoutPage and
        -- AcceptRedirectedOutWithoutPage accept, which raise none: their
        -- entry is already settled by crawl/DisposeFetch.

    @guarantee ConvertedContentCarriesFetchFlags
        -- A converted candidate's content already carries the fetch flags
        -- render_needed and soft_block_suspected in its quality result,
        -- with low_confidence recomputed, so the mirror stores one
        -- measurement.
}
