[run]
branch = True
source_pkgs = rovo
parallel = True
# Measure the Python subprocesses the tests start (the API probe, the console
# script, python -m rovo); without it only in-process lines count. INI syntax:
# one value, not the TOML list form (CONVENTIONS.md §12 claim 9).
patch = subprocess

[report]
show_missing = True
# The floor is the Justfile's coverage_floor (--fail-under), never also here.
exclude_also =
    if TYPE_CHECKING:
    if __name__ == .__main__.:
    raise NotImplementedError
    @overload
